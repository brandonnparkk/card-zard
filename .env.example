# Copy this file to .env and fill in POSTGRES_PASSWORD. .env is gitignored:
# real values never go in the repo. Pick any long random password, e.g.
#   uv run python -c "import secrets; print(secrets.token_hex(24))"
# docker compose and python-dotenv both fill in ${POSTGRES_PASSWORD} below.
# 127.0.0.1, not localhost: the container listens on IPv4 only, and on Windows
# "localhost" tries IPv6 first and waits ~2s for each refused connection.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://card_zard:${POSTGRES_PASSWORD}@127.0.0.1:5433/card_zard
TEST_DATABASE_URL=postgresql+psycopg://card_zard:${POSTGRES_PASSWORD}@127.0.0.1:5433/card_zard_test
